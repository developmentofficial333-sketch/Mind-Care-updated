rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for accounts MindCare's team has manually added as an
    // `admins/{uid}` doc (via Firebase Console — there is no self-serve way
    // to become an admin, deliberately). Used to gate review/management
    // access to applicant and provider data below.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets a signed-in user check "am I an admin?" (self-read only) so the
    // client can gate the /admin UI — nobody, including admins themselves,
    // can grant this via the client; it's set by hand in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public newsletter signup form (Newsletter.jsx / useNewsletterSignup).
    // Doc id is the subscriber's email, so only a first-time `create` is
    // allowed — the app never gets read/list access to other people's
    // emails, and a duplicate signup is rejected by rules rather than by
    // a client-side query.
    match /newsletterSubscribers/{email} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email == email
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // "Request a demo" form (RequestDemoPage.jsx). Repeat submissions are
    // expected, so this is a plain create-only write — no read/list access,
    // so nobody's submitted contact details are exposed to other clients.
    match /demoRequests/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // MindCare clinical app (/app routes). Identity data and clinical data
    // are split into separate collections, each owner-scoped by uid — no
    // client, including the owner, ever gets list/read access to anyone
    // else's documents.
    match /memberProfiles/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
    match /memberNeeds/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Provider identity/access record — keyed by the provider's own auth uid.
    // The owner can always read their own record (ProviderRoute checks this
    // on every load). Writes are either done by an admin directly (e.g.
    // approving/suspending someone who already has an account), or by the
    // user themselves self-provisioning their OWN record right after an
    // admin approval — but only ever setting role/status to exactly
    // "provider"/"approved", and only when a matching providerApprovals doc
    // (admin-written only, see below) proves an admin actually approved
    // that email. A user can never grant themselves provider access.
    match /providerProfiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // The public provider directory (CarePage.jsx) and booking flow read
      // approved providers only — a member never sees pending/rejected
      // provider records, only the provider themselves (rule above) does.
      allow get, list: if request.auth != null && resource.data.status == "approved";
      allow create, update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.role == "provider"
            && request.resource.data.status == "approved"
            && exists(/databases/$(database)/documents/providerApprovals/$(request.auth.token.email.lower())));
      allow delete: if false;
    }

    // Written only when an admin approves a providerApplications doc (see
    // below) — doc id is the applicant's lowercased email, mirroring the
    // newsletterSubscribers pattern. This is the bridge between a
    // pre-account application and a real providerProfiles record: it's what
    // the self-provisioning rule above checks for. Readable only by a
    // signed-in user whose own auth email matches, so applicants can't see
    // each other's approval status.
    match /providerApprovals/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if isAdmin();
    }

    // Provider's recurring weekly open hours (ProviderDashboardPage's
    // Availability tab), one doc per provider keyed by their own uid —
    // mirrors providerProfiles' 1:1 shape. Readable by any signed-in user
    // (not gated to "approved" providers only, unlike providerProfiles)
    // because this is working-hours data, not PII or clinical content —
    // BookPage.jsx needs to read ANY provider's hours to generate real
    // slots, and gating that on a cross-collection status lookup would add
    // rule complexity for no real security benefit here.
    match /providerAvailability/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Appointments are a subcollection under the owning member's own uid
    // path, not a top-level collection filtered by a memberUid field —
    // that makes owner-scoping trivial and airtight (no query-shape
    // assumptions needed) instead of relying on the client always
    // filtering correctly.
    match /members/{uid}/appointments/{appointmentId} {
      allow read, create: if request.auth != null && request.auth.uid == uid;

      // Still immutable to the member (original design, see above) — but
      // the PROVIDER this appointment is WITH may mark it complete or
      // cancelled from their own dashboard. Scoped to exactly the `status`
      // field, and to the provider already recorded on the EXISTING doc
      // (not any provider who happens to know the id), so this can never
      // be used to alter fee, time, or any other field of a member's
      // booking. Without this, ProviderDashboardPage's mirrored status
      // update (see providers/{providerId}/appointments below) would leave
      // the member's own copy permanently stuck on "confirmed".
      allow update: if request.auth != null
        && request.auth.uid == resource.data.providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["completed", "cancelled"];

      allow delete: if false;

      // Post-session feedback (FollowUpPage.jsx) — append-only, kept
      // separate from the appointment doc above so the original booking
      // record stays immutable.
      match /feedback/{feedbackId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Mirror of the member-side appointment doc above, written by
    // bookAppointment()'s transaction alongside it (same doc id) — lets a
    // provider see and manage their own upcoming appointments
    // (ProviderDashboardPage) without a collectionGroup query across every
    // member's appointments, which would need a rule correct across ALL
    // members at once instead of this trivially-auditable single-uid match
    // — same reasoning as members/{uid}/bookedSlots below not being a
    // top-level collection filtered by a memberUid field.
    //
    // `create` is granted to any signed-in user, not
    // request.auth.uid == providerId, because the WRITER here is the
    // booking MEMBER, not the provider — same reason
    // providers/{id}/bookedSlots below isn't scoped to the provider's own
    // uid either. The constraints below (providerId must match the path,
    // memberUid must match the writer, status must start "confirmed") are
    // what stop this being abused to plant docs in another provider's list.
    match /providers/{providerId}/appointments/{appointmentId} {
      allow create: if request.auth != null
        && request.resource.data.providerId == providerId
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.status == "confirmed";

      // Only the provider this appointment is WITH may ever read it back —
      // the one place a provider legitimately sees a member's name;
      // memberProfiles itself stays fully owner-locked.
      allow read: if request.auth != null && request.auth.uid == providerId;

      // Mirrors the member-side update rule above: status-only, and only
      // to "completed"/"cancelled".
      allow update: if request.auth != null && request.auth.uid == providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["completed", "cancelled"];
      allow delete: if false;
    }

    // A provider's free-text notes on one appointment (ProviderDashboardPage's
    // "Session notes" editor / SessionPage's read-only display for the
    // member). Deliberately a single shared doc, not a mirror like
    // providers/{id}/appointments above — here exactly one side (the
    // provider) ever writes, and both sides only need to read the same
    // content, so there's nothing to keep in sync by duplicating it.
    // Doc id reuses the appointment's own id.
    match /consultationNotes/{appointmentId} {
      // `resource == null` first, before touching resource.data: most
      // appointments have no note yet, and getConsultationNote() calls get()
      // on those to find out — evaluating resource.data on a nonexistent
      // doc errors out the whole rule (not just "false"), which Firestore
      // reports back to the client as permission-denied instead of "not
      // found". A nonexistent note has no content to protect, so it's safe
      // to let any signed-in user's existence-check through.
      allow read: if request.auth != null &&
        (resource == null
          || request.auth.uid == resource.data.providerId
          || request.auth.uid == resource.data.memberUid);

      // Cross-checked against the provider's own real appointment mirror
      // (not just the client-supplied fields on this doc) so a note can't
      // be planted for an appointment that isn't actually this provider's,
      // or attributed to a member who was never actually booked with them.
      allow create: if request.auth != null
        && request.resource.data.providerId == request.auth.uid
        && exists(/databases/$(database)/documents/providers/$(request.auth.uid)/appointments/$(appointmentId))
        && get(/databases/$(database)/documents/providers/$(request.auth.uid)/appointments/$(appointmentId)).data.memberUid == request.resource.data.memberUid;

      // Only the owning provider can edit, and never re-point a note at a
      // different provider/member after creation.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.providerId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.memberUid == resource.data.memberUid;

      allow delete: if false;
    }

    // Real-time booking-slot reservations (booking.js). Two collections,
    // written together in one transaction, cover both real conflicts a
    // national-scale booking system has to prevent:
    //  - PROVIDER-scoped: stops two different members booking the same
    //    provider at the same date/time.
    //  - MEMBER-scoped: stops one member holding two appointments (with
    //    any provider) at the same date/time.
    // Both rely on `create` being the only granted operation — Firestore
    // treats a write to an existing doc id as an `update`, so a second
    // reservation attempt at the same id is rejected by the rules
    // themselves, not just a client-side check. No identifying info about
    // who booked is stored on the provider side.
    match /providers/{providerId}/bookedSlots/{slotId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /members/{uid}/bookedSlots/{slotId} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // "Join as a provider" application (ProviderApplicationPage.jsx). Not a
    // self-serve signup — this just queues an application for MindCare's
    // team to manually verify credentials, same create-only public-form
    // pattern as demoRequests. Only admins (see isAdmin() above) can read or
    // update applications — reviewing and approving/rejecting them from
    // /admin — so applicants' contact and license details are never exposed
    // to other clients.
    match /providerApplications/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.createdAt == request.time;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
